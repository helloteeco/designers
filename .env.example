# Design Studio — Environment Variables
# Copy this to .env.local and fill in your values

# ── REQUIRED: Google Gemini (AI renders, cutouts, edits, product sourcing) ──
# Without this key all image features return 500s and the health badge shows NO_KEY.
GEMINI_API_KEY=your-gemini-key-here

# ── Optional: Supabase (image storage + multi-user sync) ──
# Recommended for production — localStorage fallback works for demos but hits
# the ~5-10 MB browser quota after a few rendered rooms. The Storage bucket
# must be named "cutouts" with public read.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional: Matterport scan import (room + panorama auto-pull) ──
MATTERPORT_TOKEN_ID=
MATTERPORT_TOKEN_SECRET=
